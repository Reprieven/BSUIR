Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"y", ",", "z", ",", "x"}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eq1", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "x", "]"}], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"y", "[", "x", "]"}], ")"}], "2"], "-", 
      RowBox[{"3", 
       RowBox[{"z", "[", "x", "]"}]}]}], "==", "0"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eq2", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"z", "'"}], "[", "x", "]"}], "-", 
      RowBox[{"4", 
       RowBox[{
        RowBox[{"y", "'"}], "[", "x", "]"}]}], "-", 
      RowBox[{"7", 
       RowBox[{"z", "[", "x", "]"}]}]}], "==", "0"}]}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"initialConditions", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "==", "1"}], ",", 
      RowBox[{
       RowBox[{"z", "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numericalSolution", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eq1", ",", "eq2", ",", "initialConditions"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "z"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"y", "[", "x", "]"}], ",", 
       RowBox[{"z", "[", "x", "]"}]}], "}"}], "/.", " ", 
     "numericalSolution"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Green", ",", "Purple"}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<y(x)\>\"", ",", "\"\<z(x)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "30"}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
