Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f4", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"5", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"2", "x"}], "+", "1"}], "]"}]}], "-", 
    RowBox[{"3", 
     SuperscriptBox["x", "2"]}], "-", 
    RowBox[{"5", "x"}], "+", "4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f4", "''"}], "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "0.5"}], ",", "1"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f4", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "0.5"}], ",", "1"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eps", "=", "0.001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f4", "[", "b", "]"}], "*", 
   RowBox[{
    RowBox[{"f4", "''"}], "[", "b", "]"}]}], "//", 
  "N"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f4", "[", "a", "]"}], "*", 
   RowBox[{
    RowBox[{"f4", "''"}], "[", "a", "]"}]}], "//", 
  "N"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xn1", "=", "b"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"xn2", "=", "xn1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"xn1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"xn1", "-", 
        FractionBox[
         RowBox[{"f4", "[", "xn1", "]"}], 
         RowBox[{
          RowBox[{"f4", "'"}], "[", "xn1", "]"}]]}], ")"}], "//", "N"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"xn2", "-", "xn1"}], "]"}], "<", "eps"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
